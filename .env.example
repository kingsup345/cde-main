# ============================================================
# Crypto Decision Engine — .env.example
# Copy to .env (local dev). For deployment, set these in the
# Render / Netlify dashboards — see DEPLOYMENT.md.
# ============================================================

# ===================== RENDER (server worker) =====================
# Bybit API — only used when BOT_DRY_RUN=false. For sim-only use, dummy values
# are fine (the 4 sim bots never place a real order).
BYBIT_API_KEY=your_bybit_api_key
BYBIT_SECRET_KEY=your_bybit_secret_key
BYBIT_TESTNET=true

# Long random string. Guards the REAL-money endpoints (/api/bot, /api/account,
# /api/decisions). The sim bot endpoints are deliberately tokenless.
BOT_ADMIN_TOKEN=your_long_random_admin_token

# Safety switches for the LIVE bot only (the 4 sim bots ignore these).
BOT_DRY_RUN=true          # true = never send a real order
BOT_AUTOSTART=false       # true = start scanning on boot
BOT_RISK_LEVEL=medium     # low | medium | high
BOT_SYMBOLS=100           # universe size

# --- Signal / sizing knobs (live bot + all 4 sim bots) ---
# BOT_MIN_CONFIDENCE — SIGNAL SCORE 0-100. Reaches the live bot and every sim
# bot (Intraday / Pro / Prev-4H Range / TrendBreakout). Unset → each bot's own
# calibrated floor (Intraday 52, Pro 70, Prev-4H 55, TrendBreakout 70).
BOT_MIN_CONFIDENCE=60

# BOT_PATH_MIN_CONFIDENCE — IGNORED. The old probability-scaled "Path" bot was
# replaced by Prev-4H Range (a score bot). Leave blank.
BOT_PATH_MIN_CONFIDENCE=

# BOT_POSITION_PERCENT — operator ceiling only. Every sim position is sized at
# 10% of equity (POSITION_TARGET_PCT); this does NOT override that.
BOT_POSITION_PERCENT=10

# BOT_MAX_OPEN_POSITIONS — SIM bot concurrent-position cap. 7 → each sim bot may
# hold up to 7 positions of 10% equity each (70% invested, ~20% cash buffer
# under the 80% MAX_TOTAL_EXPOSURE_PERCENT ceiling). The worker clamps this to
# MAX_TOTAL_EXPOSURE_PERCENT / POSITION_TARGET_PCT (= 8) so a too-high value
# can't throw EXPOSURE_MODEL_INVALID and freeze the sims. The LIVE bot keeps its
# own cap of 2 (DEFAULT_INTRADAY_PARAMS), unaffected by this.
BOT_MAX_OPEN_POSITIONS=7
BOT_MAX_FUTURES_POSITIONS=2

# --- Scan / rate-limit tuning (live bot) ---
BOT_SCAN_CONCURRENCY=5
BOT_SCAN_INTERVAL_SECONDS=300
BOT_KLINE_INTERVAL=240
BOT_REENTRY_COOLDOWN_HOURS=24
BOT_RATE_LIMIT_MAX=120
BOT_RATE_LIMIT_WINDOW_MS=60000
BOT_REQUEST_TIMEOUT_MS=15000

# Comma-separated list of frontend origins allowed by the worker's CORS.
# Include your Netlify URL and the local dev ports.
CORS_ORIGIN=https://your-site.netlify.app,http://localhost:8080,http://localhost:5173
PORT=3001

# Telegram notifications (optional — leave blank to disable).
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# ===================== FIREBASE (server-side durable storage) =====================
# server/kvStore.ts persists to Firestore in production, a local .data/ file in
# dev. It holds: bot state / sim snapshots, the run archive
# (bot-archive:<botId> — read by BacktestResults, cleared by "Clear Cache +
# Server"), and the compressed candle warm-cache.
#
# WITHOUT these two vars the worker still runs, but every restart / Render
# spin-down wipes all of the above (the local disk is ephemeral on the free
# tier). The boot log prints a loud one-time warning when they're missing.
#
# FIREBASE_PROJECT_ID = the "project_id" from the service-account JSON.
FIREBASE_PROJECT_ID=your-firebase-project-id
# FIREBASE_SERVICE_ACCOUNT_KEY = the ENTIRE service-account JSON, minified to ONE
# line. Keep the \n escapes inside "private_key"; NO real newlines in an env var.
# NEVER commit the real key — keep it in .env (gitignored) or the Render dashboard.
FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"your-project","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"firebase-adminsdk-xxx@your-project.iam.gserviceaccount.com","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token","auth_provider_x509_cert_url":"https://www.googleapis.com/oauth2/v1/certs","client_x509_cert_url":"...","universe_domain":"googleapis.com"}

# ===================== NETLIFY (frontend build-time) =====================
# Consumed by Vite AT BUILD TIME and baked into the JS bundle — a change here
# needs a Netlify rebuild, not just a restart. Set in the Netlify dashboard:
# Site settings → Build & deploy → Environment.
VITE_TRADING_API_URL=https://your-worker.onrender.com
VITE_ENABLE_ANALYTICS=true

# ===================== SCRIPTS (optional, local only) =====================
# Target worker for one-off maintenance scripts.
WORKER_URL=https://your-worker.onrender.com
